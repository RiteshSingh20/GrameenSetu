# GrameenSetu Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/GrameenSetu
# Example: mongodb+srv://riteshsinghvs_db_user:password@grameensetu.axgh7x0.mongodb.net/GrameenSetu

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# OTP Configuration
OTP_TTL_MINUTES=10

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes

# Base URL Configuration
BASE_URL=http://localhost:4000
# For production: https://api.grameensetu.com

# Email Configuration (Gmail SMTP)
NOTIFY_EMAIL=your_email@gmail.com
NOTIFY_EMAIL_PASS=your_app_specific_password
# Note: Use Gmail App Password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords

# Optional: Twilio SMS Configuration (for future use)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Optional: AWS S3 Configuration (for file storage)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=your_bucket_name
# AWS_REGION=us-east-1

# Optional: Sentry Configuration (for error tracking)
# SENTRY_DSN=your_sentry_dsn

# Optional: Payment Gateway Configuration
# RAZORPAY_KEY_ID=your_key_id
# RAZORPAY_KEY_SECRET=your_key_secret
# PAYU_MERCHANT_KEY=your_merchant_key
# PAYU_MERCHANT_SALT=your_merchant_salt

# Logging Configuration
LOG_LEVEL=debug
# Options: error, warn, info, debug, trace
